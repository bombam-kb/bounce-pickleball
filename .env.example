# Firebase web app config — copy this file to `.env` and fill in the values
# from Firebase Console → Project settings → General → Your apps → SDK setup.
# See FIREBASE_SETUP.md for step-by-step instructions.
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_MESSAGING_SENDER_ID=
VITE_FB_APP_ID=
# ── Origins (optional — only when you have a custom staff domain) ──────────
# Leave blank on localhost and on the free *.vercel.app host.
# Staff is then https://<project>.vercel.app/admin (same host, different HTML).
# When you add a real domain, set both (Production only):
# VITE_PUBLIC_ORIGIN=https://www.example.com
# VITE_ADMIN_ORIGIN=https://admin.example.com
VITE_PUBLIC_ORIGIN=
VITE_ADMIN_ORIGIN=

# ── LINE Login (see FIREBASE_SETUP.md → LINE Login setup) ──────────────────
# Callback URLs to register in LINE Developers Console:
#   http://localhost:5173/auth/line/callback
#   https://<your-production-domain>/auth/line/callback
VITE_LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
# Optional extra origins allowed as LINE redirect URIs (comma-separated).
# localhost:5173–5175 and VERCEL_URL are always allowed.
# LINE_REDIRECT_ORIGINS=https://www.example.com
# Local: path to the downloaded Firebase service-account JSON (gitignored).
# Vercel: paste the JSON as one line into FIREBASE_SERVICE_ACCOUNT_JSON instead.
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON=

# ── SlipOK (PromptPay slip check) ──────────────────────────────────────────
# Server-only. Never put these in Firestore or VITE_* vars.
# Dashboard: https://slipok.com  → API Key + Branch ID
SLIPOK_API_KEY=
SLIPOK_BRANCH_ID=

# ── Slip storage (private bucket, 2-year retention — see FIREBASE_SETUP.md) ─
# Defaults to VITE_FB_STORAGE_BUCKET; set this only to use another bucket.
# FIREBASE_STORAGE_BUCKET=
