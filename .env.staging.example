# Test database for `npm run dev`. Copy to `.env.staging` (git-ignored).
# Every key below must belong to the separate test Firebase project.
# `npm run dev` refuses to start if any of them is missing or points at live.
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_MESSAGING_SENDER_ID=
VITE_FB_APP_ID=

# Service account key downloaded from the test project (git-ignored).
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.staging.json

# LINE and SlipOK keys are shared from `.env` unless you set them here.
